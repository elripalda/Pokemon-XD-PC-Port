file(GLOB _files "${LOCALE_DIR}/*.txt")
list(SORT _files)
set(_out "// Generated by engine/i18n/embed_locale.cmake from locale/*.txt. Do not edit.\n#include <cstddef>\nnamespace engine::i18n {\nstruct EmbeddedLocale { const char* code; const unsigned char* text; size_t size; };\n")
set(_table "")
foreach (_f ${_files})
  get_filename_component(_code "${_f}" NAME_WE)
  if (NOT _code MATCHES "^[a-z][a-z]$")
    continue()
  endif ()
  file(READ "${_f}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _size "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(APPEND _out "static const unsigned char kData_${_code}[] = {${_bytes}0};\n")
  string(APPEND _table "  {\"${_code}\", kData_${_code}, ${_size}},\n")
endforeach ()
string(APPEND _out "extern const EmbeddedLocale kEmbeddedLocales[];\nconst EmbeddedLocale kEmbeddedLocales[] = {\n${_table}  {nullptr, nullptr, 0},\n};\n}\n")
file(WRITE "${OUT}.tmp" "${_out}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
